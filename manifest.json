{
  "manifest_version": 3,
  "name": "Course File Saver",
  "version": "1.1.8",
  "description": "Save original documents from accessible Blackboard previews and AWS Academy Student Guides.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "blackboard-file-saver@yassine-abid.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "downloads"
  ],
  "background": {
    "scripts": [
      "scripts/background.js"
    ],
    "service_worker": "scripts/background.js"
  },
  "host_permissions": [
    "https://*.blackboard.com/*",
    "https://awsacademy.instructure.com/*",
    "https://emergingtalent.contentcontroller.com/*",
    "https://awsacademy.contentcontroller.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://awsacademy.instructure.com/*",
        "https://emergingtalent.contentcontroller.com/*",
        "https://awsacademy.contentcontroller.com/*"
      ],
      "js": [
        "scripts/capture-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://awsacademy.instructure.com/*",
        "https://emergingtalent.contentcontroller.com/*",
        "https://awsacademy.contentcontroller.com/*"
      ],
      "js": [
        "scripts/capture-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      }
    }
  },
  "action": {
    "default_title": "Save course files",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
