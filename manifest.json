{
  "manifest_version": 3,
  "name": "Blackboard File Saver",
  "version": "1.0.0",
  "description": "Save original PDFs and documents referenced by Blackboard previews you can already open.",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "scripting", "webNavigation", "downloads"],
  "host_permissions": ["https://*.blackboard.com/*"],
  "action": {
    "default_title": "Save Blackboard files",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
